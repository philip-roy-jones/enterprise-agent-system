{
  "ask_staff": {
    "conditions": "Authorized company, campaign and current observation",
    "description": "Ask the staff member the disclosed question and wait for their answer",
    "desktop": false,
    "expected": "A durable question in this job's conversation; an answer never authorizes a desktop action",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "question": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "question"
      ],
      "title": "StaffQuestion",
      "type": "object"
    },
    "mutation": false,
    "output_schema": {
      "additionalProperties": false,
      "properties": {
        "answer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answer"
        },
        "created_at": {
          "title": "Created At",
          "type": "number"
        },
        "message_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message Id"
        },
        "question": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "question_id": {
          "title": "Question Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "answered"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "question",
        "question_id",
        "status",
        "created_at"
      ],
      "title": "QuestionResult",
      "type": "object"
    },
    "permission": "read",
    "recovery": "Re-observe and return structured recovery; never blindly repeat a save",
    "retry_limit": 2,
    "timeout_seconds": 10
  },
  "complete": {
    "conditions": "Authorized company and campaign; read-only application access",
