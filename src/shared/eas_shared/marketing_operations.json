          "type": "boolean"
        },
        "verified": {
          "const": true,
          "title": "Verified",
          "type": "boolean"
        }
      },
      "required": [
        "verified",
        "acceptance_required"
      ],
      "title": "Completed",
      "type": "object"
    },
    "permission": "read",
    "recovery": "Re-observe and return structured recovery; never blindly repeat a save",
    "retry_limit": 2,
    "timeout_seconds": 10
  },
