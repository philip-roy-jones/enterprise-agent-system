        "company_id": {
          "default": "ACME",
          "title": "Company Id",
          "type": "string"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "campaign_id"
      ],
      "title": "CampaignOperation",
      "type": "object"
    },
    "mutation": false,
    "output_schema": {
      "additionalProperties": false,
      "properties": {
        "acceptance_required": {
          "const": true,
