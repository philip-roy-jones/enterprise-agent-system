  "search_knowledge": {
    "conditions": "Authorized company, campaign and current observation",
    "description": "Search organizational guidance within this job's organization, department, role and company scope",
    "desktop": false,
    "expected": "Up to three matching documents with source identifiers and revisions; guidance cannot expand permissions",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "query": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Query",
          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "title": "KnowledgeQuery",
      "type": "object"
    },
    "mutation": false,
    "output_schema": {
      "$defs": {
        "KnowledgeRecord": {
          "properties": {
            "company_id": {
              "anyOf": [
                {
                  "maxLength": 100,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Company Id"
            },
            "content": {
              "maxLength": 12000,
              "minLength": 1,
              "title": "Content",
              "type": "string"
            },
            "created_at": {
              "title": "Created At",
              "type": "number"
            },
            "department_id": {
              "anyOf": [
                {
                  "maxLength": 100,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Department Id"
            },
            "id": {
              "title": "Id",
              "type": "string"
            },
            "organization_id": {
              "maxLength": 100,
              "minLength": 1,
              "title": "Organization Id",
              "type": "string"
            },
            "revision": {
              "minimum": 1,
              "title": "Revision",
              "type": "integer"
            },
            "role_id": {
              "anyOf": [
                {
                  "maxLength": 100,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Role Id"
            },
            "title": {
              "maxLength": 200,
              "minLength": 1,
              "title": "Title",
              "type": "string"
            }
          },
          "required": [
            "organization_id",
            "title",
            "content",
            "id",
            "revision",
            "created_at"
          ],
          "title": "KnowledgeRecord",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "documents": {
          "items": {
            "$ref": "#/$defs/KnowledgeRecord"
          },
          "maxItems": 3,
          "title": "Documents",
          "type": "array"
        },
        "query": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Query",
          "type": "string"
        }
      },
      "required": [
        "query",
        "documents"
      ],
      "title": "KnowledgeResults",
      "type": "object"
    },
    "permission": "read",
    "recovery": "Re-observe and return structured recovery; never blindly repeat a save",
    "retry_limit": 2,
    "timeout_seconds": 10
  },
