  "capture_screen": {
    "conditions": "Server-authorized read of the assigned worker desktop; no record required",
    "description": "Capture the permitted visual surface for this conversation; mediated applications disclose only their filtered view",
    "desktop": true,
    "expected": "A timestamped image labeled desktop, browser_fixture, or mediated_application; never assume it shows the whole screen",
    "input_schema": {
      "additionalProperties": false,
      "properties": {},
      "title": "Empty",
      "type": "object"
    },
    "mutation": false,
    "output_schema": {
      "additionalProperties": false,
      "properties": {
        "captured_at": {
          "title": "Captured At",
          "type": "number"
        },
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 20000,
          "title": "Height",
          "type": "integer"
        },
        "screenshot": {
          "pattern": "^[a-zA-Z0-9_-]+\\.png$",
          "title": "Screenshot",
          "type": "string"
        },
        "surface": {
          "enum": [
            "desktop",
            "browser_fixture",
            "mediated_application"
          ],
          "title": "Surface",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 20000,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "screenshot",
        "width",
        "height",
        "captured_at",
        "surface"
      ],
      "title": "ScreenCapture",
      "type": "object"
    },
    "permission": "read",
    "recovery": "Re-observe and return structured recovery; never blindly repeat a save",
    "retry_limit": 2,
    "timeout_seconds": 10
  },
