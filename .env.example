# Copy to .env for the optional local browser fixture.
# For backend + Windows worker setup, see docs/developer-setup.md.
EAS_DATA_DIR=runtime
EAS_BACKEND_URL=http://127.0.0.1:8000
EAS_BIND_HOST=127.0.0.1
EAS_BIND_PORT=8000
EAS_STAFF_TOKEN=local-staff-demo
EAS_WORKER_TOKEN=local-worker-demo
# Configure independently on backend and edge; receiving a job is not authorization.
EAS_WORKER_ORGANIZATION_ID=acme
EAS_WORKER_ROLE_IDS=invoice_correction
EAS_DEVELOPER_TOKEN=local-developer-demo
EAS_MODEL_MODE=simulated
# OpenRouter is installed; adding a key alone keeps the simulated mode above.
EAS_MODEL_PROVIDER=openrouter
EAS_MODEL_ID=openai/gpt-5.6-luna
# Keep the actual key only in .env or the worker's environment.
OPENROUTER_API_KEY=
EAS_HEADLESS=true
EAS_JOB_TIMEOUT_SECONDS=900
EAS_MAX_MODEL_CALLS=12
# The same Finance workflow can use the browser fixture or a native Windows app.
EAS_DESKTOP_ADAPTER=browser
EAS_WINDOWS_BRIDGE_URL=http://127.0.0.1:8765
EAS_WINDOWS_TOKEN=
# Legacy desktop path: independent controller; the application API can be disabled.
# EAS_DESKTOP_ADAPTER=windows_accessibility
EAS_DESKTOP_AGENT_URL=http://127.0.0.1:8766
EAS_DESKTOP_AGENT_TOKEN=
# Prefer accessibility patterns; mouse_keyboard exercises actual clicks and typing.
EAS_DESKTOP_INPUT_MODE=accessibility
# Trusted metadata plugins on the server; executable workflow plugins on the edge.
EAS_SERVER_ROLE_MODULES=
EAS_WORKFLOW_MODULES=
